<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Logout Button -->
        <Button
            android:id="@+id/logoutButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="end"
            android:background="@drawable/lavender_border"
            android:text="Log Out"
            android:textSize="12sp" />

        <!-- Subjects Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <!-- Title -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subjects"
                android:textSize="36sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Row 1 -->
            <Button
                android:id="@+id/Maths"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/lavender"
                android:text="Maths"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/textView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/Physics" />

            <Button
                android:id="@+id/Physics"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/lavender"
                android:text="Physics"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/textView"
                app:layout_constraintStart_toEndOf="@id/Maths"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Row 2 -->
            <Button
                android:id="@+id/Chemistry"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/lavender"
                android:text="Chemistry"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/Maths"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/Biology" />

            <Button
                android:id="@+id/Biology"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/lavender"
                android:text="Biology"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/Physics"
                app:layout_constraintStart_toEndOf="@id/Chemistry"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Row 3 -->
            <Button
                android:id="@+id/English"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/lavender"
                android:text="English"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/Chemistry"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/Hindi" />

            <Button
                android:id="@+id/Hindi"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/lavender"
                android:text="Hindi"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/Biology"
                app:layout_constraintStart_toEndOf="@id/English"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Row 4 -->
            <Button
                android:id="@+id/sst"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/lavender"
                android:text="S.S.T"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/English"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/Computer" />

            <Button
                android:id="@+id/Computer"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/lavender"
                android:text="Computer"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/Hindi"
                app:layout_constraintStart_toEndOf="@id/sst"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Show Tasks Button -->
        <Button
            android:id="@+id/showTasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/lavender_border"
            android:text="Show Tasks"
            android:textSize="14sp" />

        <!-- List View Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <ListView
                android:id="@+id/taskListView"
                android:layout_width="0dp"
                android:layout_height="300dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>
